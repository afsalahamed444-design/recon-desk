# Names only; copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./data/recon.db      # use postgresql+psycopg2://... in production
JWT_SECRET=                                  # required in production, long random string
ANTHROPIC_API_KEY=                           # optional; without it mapping falls back to fuzzy matching
ANTHROPIC_MODEL=claude-sonnet-4-6
DEMO_PASSWORD=                               # password given to the seeded demo users
SEED_ON_START=true                           # load demo users, rate cards and 10k sample orders if DB is empty
SEED_ORDERS=10000
DATA_DIR=./data
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173
